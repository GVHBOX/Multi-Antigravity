component StatusPill inherits Rectangle {
    in property <string> text;
    in property <color> pill_color: #38bdf8;
    in property <bool> show_dot: true;

    background: pill_color.transparentize(88%);
    border-color: pill_color.transparentize(65%);
    border-width: 1px;
    border-radius: root.height > 24px ? 8px : 5px;
    height: 26px;

    HorizontalLayout {
        padding-left: root.height > 24px ? 12px : 10px;
        padding-right: root.height > 24px ? 12px : 10px;
        spacing: 6px;
        alignment: center;

        if show_dot : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 5px;
            background: pill_color;
            y: (parent.height - 6px) / 2;
        }

        Text {
            text: root.text;
            color: pill_color;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component KpiCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> sub_left;
    in property <string> sub_right;
    in property <color> val_color: #f1f5f9;
    in property <color> highlight_color: #38bdf8;

    background: #0e131f;
    border-color: #1e293b;
    border-width: 1px;
    border-radius: 10px;

    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: root.highlight_color;
    }

    VerticalLayout {
        padding-left: 18px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 8px;
        alignment: center;

        HorizontalLayout {
            Text {
                text: root.title;
                color: #94a3b8;
                font-size: 13px;
                horizontal-alignment: left;
            }
            Text {
                text: root.sub_left;
                color: #64748b;
                font-size: 12px;
                horizontal-alignment: right;
            }
        }

        Text {
            text: root.value;
            color: root.val_color;
            font-size: 27px;
            font-weight: 800;
        }

        Text {
            text: root.sub_right;
            color: #64748b;
            font-size: 12px;
        }
    }
}

component KeyButton inherits Rectangle {
    in property <string> key_label;
    in property <string> action_label;
    in property <color> accent_color: #38bdf8;
    callback clicked();

    background: ta.pressed ? #1e293b : (ta.has_hover ? #172033 : #0e131f);
    border-color: ta.has_hover ? accent_color : #1e293b;
    border-width: 1px;
    border-radius: 6px;
    height: 40px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;

        Rectangle {
            background: #1e293b;
            border-color: #334155;
            border-width: 1px;
            border-radius: 6px;
            height: 24px;
            width: root.key_label == "Space" ? 46px : 26px;
            y: (parent.height - 24px) / 2;

            Text {
                text: root.key_label;
                color: #cbd5e1;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.action_label;
            color: ta.has_hover ? #f8fafc : #cbd5e1;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Antigravity 多实例管理器 v" + root.app_version;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1900px;
    preferred-height: 1040px;
    min-width: 1400px;
    min-height: 820px;
    background: root.redraw_tick == 0 ? #07090e : #07090f;
    in-out property <int> redraw_tick: 0;

    in property <string> app_title: "Antigravity 多实例管理器";
    in property <string> app_subtitle: "环境隔离与进程监控";
    in property <string> app_version: "1.0.0";
    in property <string> kernel_status: "内核就绪";
    in property <string> ram_overhead: "座舱: --";
    in property <string> current_time: "--:--:--";

    in property <bool> host_running: false;
    in property <string> sandbox_root: "--";
    in property <string> host_port: "--";
    in property <float> host_cpu: 0.8;
    in property <float> host_ram: 342.6;

    in property <bool> sub_running: false;
    in property <string> sub_pid: "--";
    in property <string> sub_port: "--";
    in property <float> sub_cpu: 0.0;
    in property <float> sub_ram: 0.0;

    in property <string> total_ram: "342.6 MB";
    in property <string> toast_message: "座舱已就绪";

    in property <string> log_content: "";

    callback action_space();
    callback action_kill();
    callback action_restart();
    callback action_clear();
    callback action_open();
    callback action_quit();

    forward-focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == " ") {
                root.action_space();
                accept
            } else if (event.text == "k" || event.text == "K") {
                root.action_kill();
                accept
            } else if (event.text == "r" || event.text == "R") {
                root.action_restart();
                accept
            } else if (event.text == "c" || event.text == "C") {
                root.action_clear();
                accept
            } else if (event.text == "o" || event.text == "O") {
                root.action_open();
                accept
            } else if (event.text == "q" || event.text == "Q") {
                root.action_quit();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: root.redraw_tick == 0 ? #07090e : #07090f;
    }

    VerticalLayout {
        width: min(parent.width, 99999px);
        padding-top: 24px;
        padding-bottom: 24px;
        padding-left: 48px;
        padding-right: 48px;
        spacing: 16px;

        Rectangle {
            background: #0e121b;
            border-color: #1e293b;
            border-width: 1px;
            border-radius: 8px;
            height: 64px;

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 38px;
                        height: 38px;
                        y: (parent.height - 38px) / 2;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.app_title;
                                color: #f1f5f9;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Rectangle {
                                background: rgba(56, 189, 248, 0.10);
                                border-color: rgba(56, 189, 248, 0.25);
                                border-width: 1px;
                                border-radius: 4px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "v" + root.app_version;
                                        color: #38bdf8;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: "/";
                                color: #475569;
                                font-size: 15px;
                            }
                            Text {
                                text: root.app_subtitle;
                                color: #94a3b8;
                                font-size: 14px;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StatusPill {
                            text: root.kernel_status;
                            pill_color: #34d399;
                            show_dot: true;
                            height: 34px;
                        }

                        StatusPill {
                            text: root.ram_overhead;
                            pill_color: #38bdf8;
                            show_dot: false;
                            height: 34px;
                        }

                        Rectangle {
                            background: rgba(56, 189, 248, 0.08);
                            border-color: rgba(56, 189, 248, 0.22);
                            border-width: 1px;
                            border-radius: 8px;
                            height: 34px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;

                                Text {
                                    text: root.current_time;
                                    color: #38bdf8;
                                    font-size: 18px;
                                    font-weight: 700;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

            }
        }

        HorizontalLayout {
            spacing: 16px;
            height: 110px;

            KpiCard {
                title: "主机进程";
                sub_left: root.host_running ? "在线" : "未运行";
                value: root.host_running ? "进程在线" : "未运行";
                sub_right: root.host_port == "--" ? "服务未就绪" : "服务: " + root.host_port;
                val_color: root.host_running ? #34d399 : #64748b;
                highlight_color: #34d399;
            }

            KpiCard {
                title: "分身进程";
                sub_left: root.sub_running ? "在线" : "未运行";
                value: root.sub_running ? "进程在线" : "未运行";
                sub_right: root.sub_running ? (root.sub_port == "--" ? "服务未就绪" : "服务: " + root.sub_port) : "服务未启动";
                val_color: root.sub_running ? #38bdf8 : #64748b;
                highlight_color: #38bdf8;
            }

            KpiCard {
                title: "双实例总内存";
                sub_left: "RSS";
                value: root.total_ram;
                sub_right: "主机 " + Math.round(root.host_ram) + " MB · 分身 " + Math.round(root.sub_ram) + " MB";
                val_color: #f1f5f9;
                highlight_color: #818cf8;
            }

            KpiCard {
                title: "凭据隔离";
                sub_left: "沙箱路径";
                value: "已隔离";
                sub_right: "独立凭据";
                val_color: #c084fc;
                highlight_color: #c084fc;
            }
        }

        HorizontalLayout {
            spacing: 16px;
            min-height: 200px;

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #34d399; y: (parent.height - 10px) / 2; }
                            Text { text: "主机实例 · 主账号"; color: #f1f5f9; font-size: 15px; font-weight: 700; }
                        }
                        StatusPill { text: "主机进程"; pill_color: #34d399; show_dot: false; height: 20px; }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        HorizontalLayout {
                            Text { text: "语言服务:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: root.host_port; color: #818cf8; font-size: 13px; font-weight: 600; }
                        }
                        HorizontalLayout {
                            Text { text: "账号状态:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: "主账号"; color: #34d399; font-size: 13px; }
                        }
                        HorizontalLayout {
                            Text { text: "CPU 负载:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.host_cpu / 100.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);
                                }
                            }
                            Text { text: Math.round(root.host_cpu) + "%"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            Text { text: "RSS:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.host_ram / 1024.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
                                }
                            }
                            Text { text: Math.round(root.host_ram) + " MB"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                    }
                }
            }

            Rectangle {
                background: #0e121b;
                border-color: root.sub_running ? #0284c7 : #1e293b;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                height: 330px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.sub_running ? #38bdf8 : #64748b;
                                y: (parent.height - 10px) / 2;
                            }
                        Text { text: "分身实例 · 第二账号"; color: #f1f5f9; font-size: 15px; font-weight: 700; }
                        }
                        StatusPill {
                            text: root.sub_running ? "分身进程" : "已停止";
                            pill_color: root.sub_running ? #38bdf8 : #64748b;
                            show_dot: false;
                            height: 20px;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        HorizontalLayout {
                            Text { text: "语言服务:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: root.sub_port; color: #818cf8; font-size: 13px; font-weight: 600; }
                        }
                        HorizontalLayout {
                            Text { text: "账号状态:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: "第二账号"; color: #fbbf24; font-size: 13px; }
                        }
                        HorizontalLayout {
                            Text { text: "CPU 负载:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.sub_cpu / 100.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);
                                }
                            }
                            Text { text: Math.round(root.sub_cpu) + "%"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            Text { text: "RSS:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.sub_ram / 1024.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
                                }
                            }
                            Text { text: Math.round(root.sub_ram) + " MB"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;

                Rectangle {
                    background: #0e121b;
                    border-color: #1e293b;
                    border-width: 1px;
                    border-radius: 8px;
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    height: 330px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "沙箱环境"; color: #f1f5f9; font-size: 14px; font-weight: 700; }
                            Text { text: "data/instance_2"; color: #64748b; font-size: 12px; }
                        }

                        VerticalLayout {
                            spacing: 10px;

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "USERPROFILE"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "...\\data\\instance_2\\home (已隔离)"; color: #34d399; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "APPDATA"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "...\\data\\instance_2\\AppData\\Roaming (已隔离)"; color: #34d399; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "LOCALAPPDATA"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "保持系统默认"; color: #38bdf8; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "SSH_CONNECTION"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "独立凭据"; color: #c084fc; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "沙箱根目录"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.sandbox_root; color: #94a3b8; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; horizontal-alignment: right; }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: #05070c;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "诊断日志"; color: #94a3b8; font-size: 14px; font-weight: 700; }
                        Text { text: "跟随最新"; color: #38bdf8; font-size: 12px; }
                    }

                    Rectangle {
                        background: #07090e;
                        border-color: #1e293b;
                        border-width: 1px;
                        border-radius: 8px;
                        vertical-stretch: 1;
                        clip: true;

                        log_text := Text {
                            x: 14px;
                            width: parent.width - 28px;
                            y: min(0px, parent.height - self.height);
                            text: root.log_content;
                            color: #cbd5e1;
                            font-size: 13px;
                            font-family: "Cascadia Mono";
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;

                KeyButton {
                    key_label: "Space";
                    action_label: "启动/唤醒分身";
                    accent_color: #38bdf8;
                    clicked => { root.action_space(); }
                }

                KeyButton {
                    key_label: "K";
                    action_label: "停止分身";
                    accent_color: #fb7185;
                    clicked => { root.action_kill(); }
                }

                KeyButton {
                    key_label: "R";
                    action_label: "重启语言服务";
                    accent_color: #fbbf24;
                    clicked => { root.action_restart(); }
                }

                KeyButton {
                    key_label: "C";
                    action_label: "清除独立凭据";
                    accent_color: #fb7185;
                    clicked => { root.action_clear(); }
                }

                KeyButton {
                    key_label: "O";
                    action_label: "打开沙箱目录";
                    accent_color: #818cf8;
                    clicked => { root.action_open(); }
                }

                Rectangle { horizontal-stretch: 1; }

                KeyButton {
                    key_label: "Q";
                    action_label: "退出座舱";
                    accent_color: #fb7185;
                    clicked => { root.action_quit(); }
                }
            }

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 8px;
                height: 36px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "◆"; color: #38bdf8; font-size: 13px; vertical-alignment: center; }
                        Text { text: root.toast_message; color: #94a3b8; font-size: 13px; vertical-alignment: center; }
                    }

                }
            }
        }
    }

}
