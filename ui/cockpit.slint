component StatusPill inherits Rectangle {
    in property <string> text;
    in property <color> pill_color: #38bdf8;
    in property <bool> show_dot: true;

    background: pill_color.transparentize(88%);
    border-color: pill_color.transparentize(65%);
    border-width: 1px;
    border-radius: root.height > 24px ? 8px : 5px;
    height: 26px;

    HorizontalLayout {
        padding-left: root.height > 24px ? 12px : 10px;
        padding-right: root.height > 24px ? 12px : 10px;
        spacing: 6px;
        alignment: center;

        if show_dot : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 5px;
            background: pill_color;
            y: (parent.height - 6px) / 2;
        }

        Text {
            text: root.text;
            color: pill_color;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export struct LogLineData {
    line_no: string,
    time_str: string,
    level: string,
    level_color: color,
    tag: string,
    tag_color: color,
    text: string,
    text_color: color,
}

component LogTab inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <bool> is_active: false;
    callback clicked();

    background: is_active ? #172033 : (ta.has_hover ? rgba(255, 255, 255, 0.05) : transparent);
    border-radius: 4px;
    height: 28px;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            text: root.title;
            color: root.is_active ? #38bdf8 : (ta.has_hover ? #e2e8f0 : #64748b);
            font-size: 12px;
            font-weight: root.is_active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    if is_active : Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width;
        background: #38bdf8;
    }
}

component ActionButton inherits Rectangle {
    in property <string> key_text;
    in property <string> label_text;
    in property <color> key_color: #38bdf8;
    in property <color> text_color: #f8fafc;
    in property <color> base_border: #27354f;
    in property <color> hover_border: #38bdf8;
    in property <bool> enabled: true;
    callback clicked();

    opacity: root.enabled ? 1.0 : 0.4;
    height: 26px;
    background: ta.has_hover && root.enabled ? #1e293b : #131b2b;
    border-color: ta.has_hover && root.enabled ? root.hover_border : root.base_border;
    border-width: 1px;
    border-radius: 5px;

    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        mouse-cursor: root.enabled ? pointer : default;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;

        Text {
            text: root.key_text;
            color: root.key_color;
            font-size: 11px;
            font-weight: 700;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
        }

        Text {
            text: root.label_text;
            color: root.text_color;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component EnvRow inherits Rectangle {
    in property <string> row_key;
    in property <string> row_val;
    in property <string> status_text;
    in property <color> status_color: #34d399;

    height: 32px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #141b28;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: space-between;

        Text {
            width: 116px;
            text: root.row_key;
            color: #cbd5e1;
            font-size: 12px;
            font-weight: 600;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
        }

        Text {
            text: root.row_val;
            color: #64748b;
            font-size: 11px;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        HorizontalLayout {
            spacing: 5px;
            alignment: end;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.status_color;
                y: (parent.height - 6px) / 2;
            }
            Text {
                text: root.status_text;
                color: root.status_color;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

component MetricRow inherits HorizontalLayout {
    in property <string> label;
    in property <float> pct: 0.0;
    in property <string> val_text;
    in property <brush> bar_brush: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);

    spacing: 12px;
    height: 22px;

    Text {
        width: 88px;
        text: root.label;
        color: #94a3b8;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        background: #131b2b;
        border-radius: 4px;
        height: 8px;
        horizontal-stretch: 1;
        y: (parent.height - 8px) / 2;

        Rectangle {
            x: 0;
            width: parent.width * Math.min(1.0, root.pct);
            height: 8px;
            border-radius: 4px;
            background: root.bar_brush;
        }
    }

    Text {
        width: 64px;
        text: root.val_text;
        color: #e2e8f0;
        font-size: 12px;
        font-family: "Cascadia Mono";
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "Antigravity 多实例管理器 v" + root.app_version;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1900px;
    preferred-height: 885px;
    min-width: 1360px;
    min-height: 760px;
    background: root.redraw_tick == 0 ? #07090e : #07090f;
    in-out property <int> redraw_tick: 0;

    in property <string> app_title: "Antigravity 多实例管理器";
    in property <string> app_subtitle: "环境隔离与进程监控";
    in property <string> app_version: "1.0.0";
    in property <string> kernel_status: "内核就绪";
    in property <string> ram_overhead: "座舱: --";
    in property <string> current_time: "--:--:--";

    in property <bool> host_running: false;
    in property <string> sandbox_root: "--";
    in property <string> host_port: "--";
    in property <float> host_cpu: 0.8;
    in property <float> host_ram: 342.6;

    in property <bool> sub_running: false;
    in property <string> sub_pid: "--";
    in property <string> sub_port: "--";
    in property <float> sub_cpu: 0.0;
    in property <float> sub_ram: 0.0;

    in property <string> total_ram: "342.6 MB";
    in property <string> toast_message: "座舱已就绪";
    in property <bool> token_present: false;

    in property <string> proxy_status: "未接入";
    in property <color> proxy_color: #64748b;
    in property <string> proxy_btn_text: "接入系统代理";
    in property <color> proxy_btn_color: #38bdf8;

    in property <string> stream_source_name: "核心流: 主机语言服务 (Host-LS)";
    in property <[LogLineData]> log_lines: [];
    in property <int> log_line_count: 0;
    in property <int> current_stream_idx: 0;

    callback action_space();
    callback action_kill();
    callback action_restart();
    callback action_clear();
    callback action_proxy();
    callback action_open();
    callback cycle_stream_source();
    callback select_stream_source(int);
    callback action_clear_log();
    callback action_quit();

    forward-focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == " ") {
                root.action_space();
                accept
            } else if (event.text == "k" || event.text == "K") {
                root.action_kill();
                accept
            } else if (event.text == "r" || event.text == "R") {
                root.action_restart();
                accept
            } else if (event.text == "c" || event.text == "C") {
                root.action_clear();
                accept
            } else if (event.text == "p" || event.text == "P") {
                root.action_proxy();
                accept
            } else if (event.text == "o" || event.text == "O") {
                root.action_open();
                accept
            } else if (event.text == "l" || event.text == "L") {
                root.cycle_stream_source();
                accept
            } else if (event.text == "q" || event.text == "Q") {
                root.action_quit();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: root.redraw_tick == 0 ? #07090e : #07090f;
    }

    VerticalLayout {
        width: min(parent.width, 99999px);
        padding-top: 24px;
        padding-bottom: 24px;
        padding-left: 48px;
        padding-right: 48px;
        spacing: 14px;

        Rectangle {
            background: #0e121b;
            border-color: #1e293b;
            border-width: 1px;
            border-radius: 10px;
            height: 64px;

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 38px;
                        height: 38px;
                        y: (parent.height - 38px) / 2;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.app_title;
                                color: #f1f5f9;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Rectangle {
                                background: rgba(56, 189, 248, 0.10);
                                border-color: rgba(56, 189, 248, 0.25);
                                border-width: 1px;
                                border-radius: 4px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "v" + root.app_version;
                                        color: #38bdf8;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.app_subtitle;
                            color: #94a3b8;
                            font-size: 13px;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StatusPill {
                            text: root.kernel_status;
                            pill_color: #34d399;
                            show_dot: true;
                            height: 32px;
                        }

                        StatusPill {
                            text: root.ram_overhead;
                            pill_color: #38bdf8;
                            show_dot: false;
                            height: 32px;
                        }

                        StatusPill {
                            text: "沙箱隔离已就绪";
                            pill_color: #c084fc;
                            show_dot: true;
                            height: 32px;
                        }

                        Rectangle {
                            background: rgba(56, 189, 248, 0.08);
                            border-color: rgba(56, 189, 248, 0.22);
                            border-width: 1px;
                            border-radius: 8px;
                            height: 32px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;

                                Text {
                                    text: root.current_time;
                                    color: #38bdf8;
                                    font-size: 17px;
                                    font-weight: 700;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            height: 240px;

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 10px;
                horizontal-stretch: 1;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 3px;
                    height: parent.height;
                    background: #34d399;
                }

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 6px;
                    alignment: start;

                    HorizontalLayout {
                        height: 26px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #34d399;
                                y: (parent.height - 8px) / 2;
                            }
                            Text {
                                text: "主机实例 · 主账号";
                                color: #f1f5f9;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: rgba(52, 211, 153, 0.10);
                                border-color: rgba(52, 211, 153, 0.26);
                                border-width: 1px;
                                border-radius: 4px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "宿主";
                                        color: #34d399;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #0a0e17;
                            border-color: #1e293b;
                            border-width: 1px;
                            border-radius: 5px;
                            height: 22px;
                            y: (parent.height - 22px) / 2;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: root.host_running ? "宿主在线" : "未运行";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 26px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: root.host_running ? "在线" : "未运行";
                            color: root.host_running ? #34d399 : #64748b;
                            font-size: 20px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.host_running ? "系统宿主环境" : "未检测到进程";
                            color: #64748b;
                            font-size: 12px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 20px;
                        spacing: 12px;
                        Text { text: "语言服务"; color: #94a3b8; font-size: 12px; width: 88px; vertical-alignment: center; }
                        Text { text: root.host_port == "--" ? "服务未就绪" : "127.0.0.1:" + root.host_port; color: #818cf8; font-size: 12px; font-family: "Cascadia Mono"; font-weight: 600; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        height: 20px;
                        spacing: 12px;
                        Text { text: "凭据存储"; color: #94a3b8; font-size: 12px; width: 88px; vertical-alignment: center; }
                        Text { text: "Windows 凭据"; color: #34d399; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    }

                    MetricRow {
                        label: "CPU";
                        pct: root.host_cpu / 100.0;
                        val_text: Math.round(root.host_cpu) + "%";
                        bar_brush: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);
                    }

                    MetricRow {
                        label: "物理内存";
                        pct: root.host_ram / 1024.0;
                        val_text: Math.round(root.host_ram) + " MB";
                        bar_brush: @linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
                    }

                    HorizontalLayout {
                        height: 26px;
                        padding-top: 4px;
                        alignment: start;

                        Text {
                            text: "宿主主进程由系统直接唤起 · 独立受管";
                            color: #475569;
                            font-size: 11px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                background: #0e121b;
                border-color: root.sub_running ? #0284c7 : #1e293b;
                border-width: 1px;
                border-radius: 10px;
                horizontal-stretch: 1;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 3px;
                    height: parent.height;
                    background: #38bdf8;
                }

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 6px;
                    alignment: start;

                    HorizontalLayout {
                        height: 26px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.sub_running ? #38bdf8 : #64748b;
                                y: (parent.height - 8px) / 2;
                            }
                            Text {
                                text: "分身实例 · 第二账号";
                                color: #f1f5f9;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: rgba(56, 189, 248, 0.10);
                                border-color: rgba(56, 189, 248, 0.26);
                                border-width: 1px;
                                border-radius: 4px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "沙箱";
                                        color: #38bdf8;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #0a0e17;
                            border-color: #1e293b;
                            border-width: 1px;
                            border-radius: 5px;
                            height: 22px;
                            y: (parent.height - 22px) / 2;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: root.sub_running ? (root.sub_pid == "--" ? "在线" : "PID " + root.sub_pid) : "未运行";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 26px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: root.sub_running ? "运行中" : "未运行";
                            color: root.sub_running ? #38bdf8 : #64748b;
                            font-size: 20px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.sub_running ? "沙箱隔离运行" : "沙箱环境就绪";
                            color: #64748b;
                            font-size: 12px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 20px;
                        spacing: 12px;
                        Text { text: "语言服务"; color: #94a3b8; font-size: 12px; width: 88px; vertical-alignment: center; }
                        Text { text: root.sub_running ? (root.sub_port == "--" ? "服务未就绪" : "127.0.0.1:" + root.sub_port) : "服务未启动"; color: #818cf8; font-size: 12px; font-family: "Cascadia Mono"; font-weight: 600; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        height: 20px;
                        spacing: 12px;
                        Text { text: "凭据存储"; color: #94a3b8; font-size: 12px; width: 88px; vertical-alignment: center; }
                        Text { text: root.token_present ? "已绑定" : "待授权"; color: root.token_present ? #fbbf24 : #64748b; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    }

                    MetricRow {
                        label: "CPU";
                        pct: root.sub_running ? (root.sub_cpu / 100.0) : 0.0;
                        val_text: root.sub_running ? (Math.round(root.sub_cpu) + "%") : "—";
                        bar_brush: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);
                    }

                    MetricRow {
                        label: "物理内存";
                        pct: root.sub_running ? (root.sub_ram / 1024.0) : 0.0;
                        val_text: root.sub_running ? (Math.round(root.sub_ram) + " MB") : "—";
                        bar_brush: @linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 26px;
                        padding-top: 2px;

                        ActionButton {
                            key_text: "Space";
                            label_text: root.sub_running ? "唤醒" : "启动分身";
                            key_color: #38bdf8;
                            text_color: #f8fafc;
                            base_border: #0284c7;
                            hover_border: #38bdf8;
                            horizontal-stretch: 1;
                            clicked => { root.action_space(); }
                        }

                        ActionButton {
                            key_text: "K";
                            label_text: "停止";
                            key_color: #fb7185;
                            text_color: #fb7185;
                            base_border: #4c1d24;
                            hover_border: #fb7185;
                            enabled: root.sub_running;
                            horizontal-stretch: 1;
                            clicked => { root.action_kill(); }
                        }

                        ActionButton {
                            key_text: "R";
                            label_text: "重启服务";
                            key_color: #fbbf24;
                            text_color: #fbbf24;
                            base_border: #453414;
                            hover_border: #fbbf24;
                            enabled: root.sub_running;
                            horizontal-stretch: 1;
                            clicked => { root.action_restart(); }
                        }

                        ActionButton {
                            key_text: "C";
                            label_text: "清除凭据";
                            key_color: #fb7185;
                            text_color: #fb7185;
                            base_border: #4c1d24;
                            hover_border: #fb7185;
                            enabled: root.token_present;
                            horizontal-stretch: 1;
                            clicked => { root.action_clear(); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 10px;
                horizontal-stretch: 4;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 22px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "隔离环境"; color: #f1f5f9; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "data\\instance_2"; color: #64748b; font-size: 12px; font-family: "Cascadia Mono"; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: end;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #34d399; y: (parent.height - 6px) / 2; }
                            Text { text: "隔离生效"; color: #34d399; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        background: #0b0f18;
                        border-color: #1e293b;
                        border-width: 1px;
                        border-radius: 8px;
                        height: 48px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: root.total_ram; color: #f1f5f9; font-size: 20px; font-weight: 800; font-family: "Cascadia Mono"; vertical-alignment: center; }
                                }
                                Text { text: "双实例物理内存汇总"; color: #94a3b8; font-size: 11px; }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                Rectangle {
                                    background: #0a0e17;
                                    border-color: #1e293b;
                                    border-width: 1px;
                                    border-radius: 5px;
                                    height: 26px;
                                    y: (parent.height - 26px) / 2;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;
                                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #34d399; y: (parent.height - 6px) / 2; }
                                        Text { text: "主机 " + Math.round(root.host_ram) + " MB"; color: #cbd5e1; font-size: 11px; font-family: "Cascadia Mono"; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    background: #0a0e17;
                                    border-color: #1e293b;
                                    border-width: 1px;
                                    border-radius: 5px;
                                    height: 26px;
                                    y: (parent.height - 26px) / 2;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;
                                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #38bdf8; y: (parent.height - 6px) / 2; }
                                        Text { text: "分身 " + Math.round(root.sub_ram) + " MB"; color: #cbd5e1; font-size: 11px; font-family: "Cascadia Mono"; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #0b0f18;
                        border-color: #1e293b;
                        border-width: 1px;
                        border-radius: 8px;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            EnvRow { row_key: "USERPROFILE"; row_val: "…\\data\\instance_2\\home"; status_text: "已隔离"; status_color: #34d399; }
                            EnvRow { row_key: "HOME"; row_val: "…\\data\\instance_2\\home"; status_text: "已隔离"; status_color: #34d399; }
                            EnvRow { row_key: "APPDATA"; row_val: "…\\data\\instance_2\\AppData\\Roaming"; status_text: "已隔离"; status_color: #34d399; }
                            EnvRow { row_key: "LOCALAPPDATA"; row_val: "保持系统默认"; status_text: "继承系统"; status_color: #38bdf8; }
                            EnvRow { row_key: "SSH_CONNECTION"; row_val: "127.0.0.1 50000 127.0.0.1 22"; status_text: "已注入"; status_color: #c084fc; }
                            EnvRow { row_key: "凭据文件"; row_val: "home\\.gemini\\jetski-standalone-oauth-token"; status_text: root.token_present ? "存在" : "不存在"; status_color: root.token_present ? #34d399 : #64748b; }
                        }
                    }

                    Rectangle {
                        background: #0b0f18;
                        border-color: #1e293b;
                        border-width: 1px;
                        border-radius: 8px;
                        height: 68px;

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "系统代理"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                StatusPill { text: root.proxy_status; pill_color: root.proxy_color; show_dot: true; height: 22px; }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "本地端口: 7890"; color: #64748b; font-size: 12px; font-family: "Cascadia Mono"; vertical-alignment: center; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;

                                    ActionButton {
                                        key_text: "O";
                                        label_text: "打开沙箱";
                                        key_color: #818cf8;
                                        text_color: #cbd5e1;
                                        base_border: #27354f;
                                        hover_border: #818cf8;
                                        clicked => { root.action_open(); }
                                    }

                                    ActionButton {
                                        key_text: "P";
                                        label_text: root.proxy_btn_text;
                                        key_color: #38bdf8;
                                        text_color: #cbd5e1;
                                        base_border: #27354f;
                                        hover_border: #38bdf8;
                                        clicked => { root.action_proxy(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 10px;
                horizontal-stretch: 6;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 28px;

                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;

                            LogTab {
                                icon: "⚡";
                                title: "主机服务";
                                is_active: root.current_stream_idx == 0;
                                clicked => { root.select_stream_source(0); }
                            }
                            LogTab {
                                icon: "🛡️";
                                title: "分身服务";
                                is_active: root.current_stream_idx == 1;
                                clicked => { root.select_stream_source(1); }
                            }
                            LogTab {
                                icon: "🌐";
                                title: "系统代理";
                                is_active: root.current_stream_idx == 2;
                                clicked => { root.select_stream_source(2); }
                            }
                            LogTab {
                                icon: "⚙️";
                                title: "座舱系统";
                                is_active: root.current_stream_idx == 3;
                                clicked => { root.select_stream_source(3); }
                            }
                            LogTab {
                                icon: "📦";
                                title: "主程序";
                                is_active: root.current_stream_idx == 4;
                                clicked => { root.select_stream_source(4); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Rectangle {
                                background: rgba(30, 41, 59, 0.6);
                                border-color: #334155;
                                border-width: 1px;
                                border-radius: 4px;
                                height: 26px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: root.log_line_count + " 行";
                                        color: #94a3b8;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: ta_clear.has_hover ? #1e293b : transparent;
                                border-color: ta_clear.has_hover ? #475569 : #334155;
                                border-width: 1px;
                                border-radius: 4px;
                                height: 26px;
                                ta_clear := TouchArea {
                                    clicked => { root.action_clear_log(); }
                                    mouse-cursor: pointer;
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "⟲";
                                        color: ta_clear.has_hover ? #f8fafc : #94a3b8;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "清空";
                                        color: ta_clear.has_hover ? #f8fafc : #94a3b8;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            StatusPill {
                                text: root.stream_source_name;
                                pill_color: #38bdf8;
                                show_dot: true;
                                height: 26px;
                            }
                        }
                    }

                    Rectangle {
                        background: #06080d;
                        border-color: #1e293b;
                        border-width: 1px;
                        border-radius: 8px;
                        vertical-stretch: 1;
                        clip: true;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: 44px;
                            height: parent.height;
                            background: #090c13;
                            border-color: #141b28;
                            border-width: 1px;
                        }

                        VerticalLayout {
                            x: 0;
                            width: parent.width;
                            y: min(0px, parent.height - self.height);
                            spacing: 1px;
                            padding-top: 6px;
                            padding-bottom: 6px;

                            if root.log_lines.length == 0 : Rectangle {
                                height: 140px;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text {
                                            text: "暂无活动数据流输出";
                                            color: #475569;
                                            font-size: 13px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "等待目标进程写入日志";
                                            color: #334155;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            for line in root.log_lines : Rectangle {
                                height: 22px;
                                background: ta_row.has_hover ? rgba(255, 255, 255, 0.04) : transparent;
                                ta_row := TouchArea {}

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 12px;
                                    spacing: 8px;

                                    Text {
                                        width: 32px;
                                        text: line.line_no;
                                        color: #475569;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 60px;
                                        text: line.time_str;
                                        color: #64748b;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        background: line.level_color.transparentize(85%);
                                        border-color: line.level_color.transparentize(60%);
                                        border-width: 1px;
                                        border-radius: 3px;
                                        height: 16px;
                                        y: (parent.height - 16px) / 2;

                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            alignment: center;
                                            Text {
                                                text: line.level;
                                                color: line.level_color;
                                                font-size: 10px;
                                                font-weight: 700;
                                                font-family: "Cascadia Mono";
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if line.tag != "" : Text {
                                        text: line.tag;
                                        color: line.tag_color;
                                        font-size: 11px;
                                        font-weight: 600;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: line.text;
                                        color: line.text_color;
                                        font-size: 12px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: #0e121b;
            border-color: #1e293b;
            border-width: 1px;
            border-radius: 8px;
            height: 32px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "◆"; color: #38bdf8; font-size: 13px; vertical-alignment: center; }
                    Text { text: root.toast_message; color: #94a3b8; font-size: 13px; vertical-alignment: center; }
                }

                Text {
                    text: "Slint 1.18 · 软件光栅后端";
                    color: #475569;
                    font-size: 12px;
                    font-family: "Cascadia Mono";
                    vertical-alignment: center;
                }
            }
        }
    }
}
