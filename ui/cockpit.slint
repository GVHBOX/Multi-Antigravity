component StatusPill inherits Rectangle {
    in property <string> text;
    in property <color> pill_color: #38bdf8;
    in property <bool> show_dot: true;

    background: pill_color.transparentize(88%);
    border-color: pill_color.transparentize(65%);
    border-width: 1px;
    border-radius: root.height > 24px ? 8px : 5px;
    height: 26px;

    HorizontalLayout {
        padding-left: root.height > 24px ? 12px : 10px;
        padding-right: root.height > 24px ? 12px : 10px;
        spacing: 6px;
        alignment: center;

        if show_dot : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 5px;
            background: pill_color;
            y: (parent.height - 6px) / 2;
        }

        Text {
            text: root.text;
            color: pill_color;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component KpiCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> sub_left;
    in property <string> sub_right;
    in property <color> val_color: #f1f5f9;
    in property <color> highlight_color: #38bdf8;

    background: #0e131f;
    border-color: #1e293b;
    border-width: 1px;
    border-radius: 10px;

    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: root.highlight_color;
    }

    VerticalLayout {
        padding-left: 18px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 8px;
        alignment: center;

        HorizontalLayout {
            Text {
                text: root.title;
                color: #94a3b8;
                font-size: 13px;
                horizontal-alignment: left;
            }
            Text {
                text: root.sub_left;
                color: #64748b;
                font-size: 12px;
                horizontal-alignment: right;
            }
        }

        Text {
            text: root.value;
            color: root.val_color;
            font-size: 27px;
            font-weight: 800;
        }

        Text {
            text: root.sub_right;
            color: #64748b;
            font-size: 12px;
        }
    }
}

export struct LogLineData {
    line_no: string,
    time_str: string,
    level: string,
    level_color: color,
    tag: string,
    tag_color: color,
    text: string,
    text_color: color,
}

component LogTab inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <bool> is_active: false;
    callback clicked();

    background: is_active ? #172033 : (ta.has_hover ? rgba(255, 255, 255, 0.05) : transparent);
    border-radius: 4px;
    height: 28px;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            text: root.title;
            color: root.is_active ? #38bdf8 : (ta.has_hover ? #e2e8f0 : #64748b);
            font-size: 12px;
            font-weight: root.is_active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    if is_active : Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width;
        background: #38bdf8;
    }
}

component KeyButton inherits Rectangle {
    in property <string> key_label;
    in property <string> action_label;
    in property <color> accent_color: #38bdf8;
    in property <bool> is_accented: false;
    callback clicked();

    background: ta.pressed ? (root.is_accented ? accent_color.mix(#000000, 60%) : #1e293b) : 
                (ta.has_hover ? (root.is_accented ? accent_color.mix(#000000, 75%) : #172033) : 
                (root.is_accented ? accent_color.mix(#0e131f, 85%) : #0e131f));
    border-color: ta.has_hover ? accent_color : 
                 (root.is_accented ? accent_color.mix(#1e293b, 40%) : #1e293b);
    border-width: 1px;
    border-radius: 6px;
    height: 40px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;

        Rectangle {
            background: root.is_accented ? accent_color.mix(#000000, 75%) : #1e293b;
            border-color: root.is_accented ? accent_color.mix(#000000, 30%) : #334155;
            border-width: 1px;
            border-radius: 6px;
            height: 24px;
            width: root.key_label == "Space" ? 46px : 26px;
            y: (parent.height - 24px) / 2;

            Text {
                text: root.key_label;
                color: root.is_accented ? accent_color : #cbd5e1;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.action_label;
            color: root.is_accented ? (ta.has_hover ? #ffffff : accent_color) : (ta.has_hover ? #f8fafc : #cbd5e1);
            font-size: 13px;
            font-weight: root.is_accented ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Antigravity 多实例管理器 v" + root.app_version;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1900px;
    preferred-height: 1040px;
    min-width: 1400px;
    min-height: 820px;
    background: root.redraw_tick == 0 ? #07090e : #07090f;
    in-out property <int> redraw_tick: 0;

    in property <string> app_title: "Antigravity 多实例管理器";
    in property <string> app_subtitle: "环境隔离与进程监控";
    in property <string> app_version: "1.0.0";
    in property <string> kernel_status: "内核就绪";
    in property <string> ram_overhead: "座舱: --";
    in property <string> current_time: "--:--:--";

    in property <bool> host_running: false;
    in property <string> sandbox_root: "--";
    in property <string> host_port: "--";
    in property <float> host_cpu: 0.8;
    in property <float> host_ram: 342.6;

    in property <bool> sub_running: false;
    in property <string> sub_pid: "--";
    in property <string> sub_port: "--";
    in property <float> sub_cpu: 0.0;
    in property <float> sub_ram: 0.0;

    in property <string> total_ram: "342.6 MB";
    in property <string> toast_message: "座舱已就绪";
    in property <bool> token_present: false;


    in property <string> proxy_status: "未部署代理";
    in property <color> proxy_color: #64748b;
    in property <string> proxy_btn_text: "部署代理";
    in property <color> proxy_btn_color: #34d399;

    in property <string> stream_source_name: "核心流: 主机语言服务 (Host-LS)";
    in property <[LogLineData]> log_lines: [];
    in property <int> log_line_count: 0;
    in property <int> current_stream_idx: 0;

    callback action_space();
    callback action_kill();
    callback action_restart();
    callback action_clear();
    callback action_proxy();
    callback action_open();
    callback cycle_stream_source();
    callback select_stream_source(int);
    callback action_clear_log();
    callback action_quit();

    forward-focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == " ") {
                root.action_space();
                accept
            } else if (event.text == "k" || event.text == "K") {
                root.action_kill();
                accept
            } else if (event.text == "r" || event.text == "R") {
                root.action_restart();
                accept
            } else if (event.text == "c" || event.text == "C") {
                root.action_clear();
                accept
            } else if (event.text == "p" || event.text == "P") {
                root.action_proxy();
                accept
            } else if (event.text == "o" || event.text == "O") {
                root.action_open();
                accept
            } else if (event.text == "l" || event.text == "L") {
                root.cycle_stream_source();
                accept
            } else if (event.text == "q" || event.text == "Q") {
                root.action_quit();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: root.redraw_tick == 0 ? #07090e : #07090f;
    }

    VerticalLayout {
        width: min(parent.width, 99999px);
        padding-top: 24px;
        padding-bottom: 24px;
        padding-left: 48px;
        padding-right: 48px;
        spacing: 16px;

        Rectangle {
            background: #0e121b;
            border-color: #1e293b;
            border-width: 1px;
            border-radius: 8px;
            height: 64px;

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 38px;
                        height: 38px;
                        y: (parent.height - 38px) / 2;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.app_title;
                                color: #f1f5f9;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Rectangle {
                                background: rgba(56, 189, 248, 0.10);
                                border-color: rgba(56, 189, 248, 0.25);
                                border-width: 1px;
                                border-radius: 4px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "v" + root.app_version;
                                        color: #38bdf8;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: "/";
                                color: #475569;
                                font-size: 15px;
                            }
                            Text {
                                text: root.app_subtitle;
                                color: #94a3b8;
                                font-size: 14px;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StatusPill {
                            text: root.kernel_status;
                            pill_color: #34d399;
                            show_dot: true;
                            height: 34px;
                        }

                        StatusPill {
                            text: root.ram_overhead;
                            pill_color: #38bdf8;
                            show_dot: false;
                            height: 34px;
                        }

                        StatusPill {
                            text: root.proxy_status;
                            pill_color: root.proxy_color;
                            show_dot: true;
                            height: 34px;
                        }

                        Rectangle {
                            background: rgba(56, 189, 248, 0.08);
                            border-color: rgba(56, 189, 248, 0.22);
                            border-width: 1px;
                            border-radius: 8px;
                            height: 34px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;

                                Text {
                                    text: root.current_time;
                                    color: #38bdf8;
                                    font-size: 18px;
                                    font-weight: 700;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

            }
        }

        HorizontalLayout {
            spacing: 16px;
            height: 110px;

            KpiCard {
                title: "主机进程";
                sub_left: root.host_running ? "在线" : "未运行";
                value: root.host_running ? "进程在线" : "未运行";
                sub_right: root.host_port == "--" ? "服务未就绪" : "服务: " + root.host_port;
                val_color: root.host_running ? #34d399 : #64748b;
                highlight_color: #34d399;
            }

            KpiCard {
                title: "分身进程";
                sub_left: root.sub_running ? (root.sub_pid == "--" ? "在线" : "PID: " + root.sub_pid) : "未运行";
                value: root.sub_running ? "进程在线" : "未运行";
                sub_right: root.sub_running ? (root.sub_port == "--" ? "服务未就绪" : "服务: " + root.sub_port) : "服务未启动";
                val_color: root.sub_running ? #38bdf8 : #64748b;
                highlight_color: #38bdf8;
            }

            KpiCard {
                title: "双实例总内存";
                sub_left: "RSS";
                value: root.total_ram;
                sub_right: "主机 " + Math.round(root.host_ram) + " MB · 分身 " + Math.round(root.sub_ram) + " MB";
                val_color: #f1f5f9;
                highlight_color: #818cf8;
            }

            KpiCard {
                title: "凭据隔离";
                sub_left: "沙箱环境";
                value: root.token_present ? "已授权" : "待授权";
                sub_right: root.token_present ? "第二账号已就绪" : "未检测到凭据";
                val_color: root.token_present ? #c084fc : #fbbf24;
                highlight_color: root.token_present ? #c084fc : #fbbf24;
            }

        }

        HorizontalLayout {
            spacing: 16px;
            min-height: 200px;

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #34d399; y: (parent.height - 10px) / 2; }
                            Text { text: "主机实例 · 主账号"; color: #f1f5f9; font-size: 15px; font-weight: 700; }
                        }
                        StatusPill { text: "主机进程"; pill_color: #34d399; show_dot: false; height: 20px; }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        HorizontalLayout {
                            Text { text: "语言服务:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: root.host_port; color: #818cf8; font-size: 13px; font-weight: 600; }
                        }
                        HorizontalLayout {
                            Text { text: "账号状态:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: "主账号"; color: #34d399; font-size: 13px; }
                        }
                        HorizontalLayout {
                            Text { text: "CPU 负载:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.host_cpu / 100.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);
                                }
                            }
                            Text { text: Math.round(root.host_cpu) + "%"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            Text { text: "RSS:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.host_ram / 1024.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
                                }
                            }
                            Text { text: Math.round(root.host_ram) + " MB"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                    }
                }
            }

            Rectangle {
                background: #0e121b;
                border-color: root.sub_running ? #0284c7 : #1e293b;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                height: 330px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.sub_running ? #38bdf8 : #64748b;
                                y: (parent.height - 10px) / 2;
                            }
                        Text { text: "分身实例 · 第二账号"; color: #f1f5f9; font-size: 15px; font-weight: 700; }
                        }
                        StatusPill {
                            text: root.sub_running ? "分身进程" : "已停止";
                            pill_color: root.sub_running ? #38bdf8 : #64748b;
                            show_dot: false;
                            height: 20px;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        HorizontalLayout {
                            Text { text: "语言服务:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: root.sub_port; color: #818cf8; font-size: 13px; font-weight: 600; }
                        }
                        HorizontalLayout {
                            Text { text: "账号状态:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Text { text: "第二账号"; color: #fbbf24; font-size: 13px; }
                        }
                        HorizontalLayout {
                            Text { text: "CPU 负载:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.sub_cpu / 100.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #38bdf8 0%, #34d399 100%);
                                }
                            }
                            Text { text: Math.round(root.sub_cpu) + "%"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            Text { text: "RSS:"; color: #94a3b8; font-size: 13px; width: 118px; }
                            Rectangle {
                                background: #1e293b;
                                border-radius: 5px;
                                height: 10px;
                                horizontal-stretch: 1;
                                y: (parent.height - 10px) / 2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, root.sub_ram / 1024.0);
                                    height: 10px;
                                    border-radius: 5px;
                                    background: @linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
                                }
                            }
                            Text { text: Math.round(root.sub_ram) + " MB"; color: #cbd5e1; font-size: 13px; width: 62px; horizontal-alignment: right; }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;

                Rectangle {
                    background: #0e121b;
                    border-color: #1e293b;
                    border-width: 1px;
                    border-radius: 8px;
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    height: 330px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "沙箱环境"; color: #f1f5f9; font-size: 14px; font-weight: 700; }
                            Text { text: "data/instance_2"; color: #64748b; font-size: 12px; }
                        }

                        VerticalLayout {
                            spacing: 10px;

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "USERPROFILE"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "...\\data\\instance_2\\home (已隔离)"; color: #34d399; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "APPDATA"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "...\\data\\instance_2\\AppData\\Roaming (已隔离)"; color: #34d399; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "LOCALAPPDATA"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "保持系统默认"; color: #38bdf8; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "SSH_CONNECTION"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "独立凭据"; color: #c084fc; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                background: #07090e;
                                border-color: #1e293b;
                                border-width: 1px;
                                border-radius: 8px;
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: space-between;
                                    Text { text: "沙箱根目录"; color: #cbd5e1; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.sandbox_root; color: #94a3b8; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; horizontal-alignment: right; }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: #05070c;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;

                            LogTab {
                                icon: "⚡";
                                title: "主机服务";
                                is_active: root.current_stream_idx == 0;
                                clicked => { root.select_stream_source(0); }
                            }
                            LogTab {
                                icon: "🛡️";
                                title: "分身服务";
                                is_active: root.current_stream_idx == 1;
                                clicked => { root.select_stream_source(1); }
                            }
                            LogTab {
                                icon: "🌐";
                                title: "免TUN代理";
                                is_active: root.current_stream_idx == 2;
                                clicked => { root.select_stream_source(2); }
                            }
                            LogTab {
                                icon: "⚙️";
                                title: "座舱系统";
                                is_active: root.current_stream_idx == 3;
                                clicked => { root.select_stream_source(3); }
                            }
                            LogTab {
                                icon: "📦";
                                title: "主程序";
                                is_active: root.current_stream_idx == 4;
                                clicked => { root.select_stream_source(4); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Rectangle {
                                background: rgba(30, 41, 59, 0.6);
                                border-color: #334155;
                                border-width: 1px;
                                border-radius: 4px;
                                height: 26px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: root.log_line_count + " 行";
                                        color: #94a3b8;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: ta_clear.has_hover ? #1e293b : transparent;
                                border-color: ta_clear.has_hover ? #475569 : #334155;
                                border-width: 1px;
                                border-radius: 4px;
                                height: 26px;
                                ta_clear := TouchArea {
                                    clicked => { root.action_clear_log(); }
                                    mouse-cursor: pointer;
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "⟲";
                                        color: ta_clear.has_hover ? #f8fafc : #94a3b8;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "清空";
                                        color: ta_clear.has_hover ? #f8fafc : #94a3b8;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            StatusPill {
                                text: root.stream_source_name;
                                pill_color: #38bdf8;
                                show_dot: true;
                                height: 26px;
                            }

                        }
                    }

                    Rectangle {
                        background: #06080d;
                        border-color: #1e293b;
                        border-width: 1px;
                        border-radius: 8px;
                        vertical-stretch: 1;
                        clip: true;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: 44px;
                            height: parent.height;
                            background: #090c13;
                            border-color: #141b28;
                            border-width: 1px;
                        }

                        VerticalLayout {
                            x: 0;
                            width: parent.width;
                            y: min(0px, parent.height - self.height);
                            spacing: 1px;
                            padding-top: 6px;
                            padding-bottom: 6px;

                            if root.log_lines.length == 0 : Rectangle {
                                height: 140px;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text {
                                            text: "暂无活动数据流输出";
                                            color: #475569;
                                            font-size: 13px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "等待目标进程写入日志";
                                            color: #334155;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            for line in root.log_lines : Rectangle {
                                height: 22px;
                                background: ta_row.has_hover ? rgba(255, 255, 255, 0.04) : transparent;
                                ta_row := TouchArea {}

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 12px;
                                    spacing: 8px;

                                    Text {
                                        width: 32px;
                                        text: line.line_no;
                                        color: #475569;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 60px;
                                        text: line.time_str;
                                        color: #64748b;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        background: line.level_color.transparentize(85%);
                                        border-color: line.level_color.transparentize(60%);
                                        border-width: 1px;
                                        border-radius: 3px;
                                        height: 16px;
                                        y: (parent.height - 16px) / 2;

                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            alignment: center;
                                            Text {
                                                text: line.level;
                                                color: line.level_color;
                                                font-size: 10px;
                                                font-weight: 700;
                                                font-family: "Cascadia Mono";
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if line.tag != "" : Text {
                                        text: line.tag;
                                        color: line.tag_color;
                                        font-size: 11px;
                                        font-weight: 600;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: line.text;
                                        color: line.text_color;
                                        font-size: 12px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;

                KeyButton {
                    key_label: "Space";
                    action_label: "启动/唤醒分身";
                    accent_color: #38bdf8;
                    clicked => { root.action_space(); }
                }

                KeyButton {
                    key_label: "K";
                    action_label: "停止分身";
                    accent_color: #fb7185;
                    clicked => { root.action_kill(); }
                }

                KeyButton {
                    key_label: "R";
                    action_label: "重启语言服务";
                    accent_color: #fbbf24;
                    clicked => { root.action_restart(); }
                }

                KeyButton {
                    key_label: "C";
                    action_label: "清除独立凭据";
                    accent_color: #fb7185;
                    clicked => { root.action_clear(); }
                }

                KeyButton {
                    key_label: "P";
                    action_label: root.proxy_btn_text;
                    accent_color: root.proxy_btn_color;
                    is_accented: true;
                    clicked => { root.action_proxy(); }
                }

                KeyButton {
                    key_label: "O";
                    action_label: "打开沙箱目录";
                    accent_color: #818cf8;
                    clicked => { root.action_open(); }
                }

                KeyButton {
                    key_label: "L";
                    action_label: "切换日志流";
                    accent_color: #38bdf8;
                    clicked => { root.cycle_stream_source(); }
                }

                Rectangle { horizontal-stretch: 1; }

                KeyButton {
                    key_label: "Q";
                    action_label: "退出座舱";
                    accent_color: #fb7185;
                    clicked => { root.action_quit(); }
                }
            }

            Rectangle {
                background: #0e121b;
                border-color: #1e293b;
                border-width: 1px;
                border-radius: 8px;
                height: 36px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "◆"; color: #38bdf8; font-size: 13px; vertical-alignment: center; }
                        Text { text: root.toast_message; color: #94a3b8; font-size: 13px; vertical-alignment: center; }
                    }

                }
            }
        }
    }

}
